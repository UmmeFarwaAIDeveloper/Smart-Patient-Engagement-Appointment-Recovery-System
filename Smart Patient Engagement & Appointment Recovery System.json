    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short, warm email body (plain HTML paragraphs, no subject line, no markdown) to a patient who missed their appointment.\nPatient: {{ $json.patient_name }}\nTreatment: {{ $json.treatment }}\nDoctor: {{ $json.doctor }}\nMissed on: {{ new Date($json.appointment_time).toLocaleDateString(\"en-GB\", { timeZone: \"Asia/Karachi\", weekday: \"long\", day: \"numeric\", month: \"long\" }) }}\nFollow-up attempt number: {{ Number($json.recovery_stage || 0) + 1 }} of 3 (1 = gentle check-in, 2 = emphasize health importance of completing treatment, 3 = last friendly nudge with an offer to help with any scheduling or cost concerns).\nRules: never judge or blame, no medical claims beyond encouraging completion of care, end by asking them to reply to this email with a preferred day/time to rebook. Start with \"Dear <patient name>,\", use <p> paragraphs only, and sign off as \"Vitalis Health Center Care Team\". Clinic: Vitalis Health Center.",
        "messages": {
          "messageValues": [
            {
              "message": "You write empathetic, concise patient communication for a healthcare clinic. Output only the email body HTML."
            }
          ]
        },
